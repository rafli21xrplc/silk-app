{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/v1/internal/jobs/process-queue",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/v1/internal/jobs/stale-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/v1/internal/jobs/retention",
      "schedule": "30 1 * * *"
    }
  ]
}
