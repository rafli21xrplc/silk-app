{
  "name": "@silk/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./seed/data.ts",
    "./seed/run": "./seed/run.ts",
    "./test-guard": "./src/test-db-guard.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx seed/index.ts",
    "db:seed:demo": "tsx seed/index.ts --demo",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@silk/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@silk/config": "workspace:*",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
