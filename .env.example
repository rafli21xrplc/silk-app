# Salin ke .env (root) untuk pengembangan lokal. Jangan pernah komit nilai asli.

# --- Database (api, packages/db) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Opsional: branch Neon terpisah untuk uji integrasi (data dihapus setiap uji)
TEST_DATABASE_URL=

# --- Auth (api) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# --- Origin (web, api) ---
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Webhook & job (web, api) ---
REVALIDATE_SECRET=
CRON_SECRET=

# --- Penyimpanan R2 (api). Kosong = penyimpanan lokal di /tmp (hanya dev) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Media profil yang sudah disetujui moderator disalin ke bucket publik terpisah (Fase 2).
# Kosong di dev = disalin ke /tmp dan dilayani lewat /v1/dev/storage/public.
R2_MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=

# --- Email (api). Kosong = email dicatat di log (hanya dev) ---
RESEND_API_KEY=
EMAIL_FROM=SILK <noreply@example.com>

# --- Anti-bot (api, web). Kosong = verifikasi dilewati (hanya dev) ---
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Monitoring & analitik ---
SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- CMS Sanity (web) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_READ_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Peta (web) ---
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Pembayaran Duitku (api, Fase 11, flag subscriptions_enabled) ---
# Kosong di dev = simulator lokal (halaman bayar tiruan di /v1/dev/duitku/pay, tanpa uang sungguhan).
# Sandbox: daftar di https://sandbox.duitku.com, buat proyek, salin Merchant Code dan API Key.
# Produksi wajib diisi bila subscriptions_enabled aktif; DUITKU_ENV=production harus dipilih eksplisit.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox

# --- Konfigurasi bisnis (api) ---
STALE_AFTER_DAYS=180

# Feature flag fitur berisiko hukum, dipisah koma. Default semua OFF; jangan nyalakan di produksi
# sebelum syarat gate terpenuhi (docs/enablement/prompt-enablement.md). Contoh: reviews_enabled
FEATURE_FLAGS=

# --- SILK Mobile (MOBILE/, demo ponsel) ---
# Origin API SILK yang dibaca server Next mobile. Bila API mati/lambat, mobile memakai data cadangan
# (MOBILE/src/demo/snapshot.json) dan menampilkan banner "data demo".
SILK_API_ORIGIN=http://127.0.0.1:4000
# Batas waktu per permintaan ke API (ms) sebelum beralih ke data cadangan.
SILK_API_TIMEOUT_MS=3500
# Isi 1 untuk demo tanpa API sama sekali (selalu data cadangan).
SILK_DEMO_ONLY=
# Isi 1 agar SILK Mobile boleh diindeks mesin pencari. Kosong = robots.txt menolak + meta noindex
# (versi demo memuat dokter fiktif dan foto ilustrasi).
SILK_ALLOW_INDEXING=
# Alamat situs web SILK untuk tombol "Daftar" di halaman Jadi mitra (/mitra). Kosong = tombol disembunyikan.
# Harga langganan di halaman itu tampil hanya bila FEATURE_FLAGS proyek mobile memuat subscriptions_enabled.
SILK_WEB_ORIGIN=
